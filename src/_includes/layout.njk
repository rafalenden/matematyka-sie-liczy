<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Matematyka Się Liczy - Korepetycje z matematyki we Wrocławiu. Przygotowanie do egzaminów, nadrabianie zaległości, profesjonalne wsparcie.">
  <meta name="keywords" content="matematyka, korepetycje, Wrocław, matura, egzamin ósmoklasisty">
  <meta property="og:title" content="{{ title | safe }}">
  <meta property="og:description" content="Profesjonalne korepetycje z matematyki we Wrocławiu i online">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://matematykasieliczy.pl">
  <meta property="og:image" content="/images/logo.svg">
  <link rel="stylesheet" href="{{ '/css/styles.css' | cacheBust }}">
  <title>{{ title | safe }}</title>
  <link rel="shortcut icon" type="image/svg+xml" href="/images/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
<header class="site-header">
  <div class="site-header__container">
    <img alt="Matematyka Się Liczy - Logo" class="site-logo" src="/images/logo.svg"/>
    <h1 class="site-title">{{ title | safe }}</h1>
    <h2 class="site-subtitle">{{ intro | safe }}</h2>
    <ul class="contact-list" aria-label="Informacje kontaktowe">
      {% if contact.email %}
        <li class="contact-list__item">
          <span class="contact-list__link email-obf" data-b64="{{ contact.email | base64 }}" aria-label="E-mail" aria-live="polite">Pokaż e‑mail</span>
        </li>
      {% endif %}
      {% if contact.phone %}
        <li class="contact-list__item">
          <span class="contact-list__link phone-obf" data-enc="{{ contact.phone | phoneEnc }}" data-rev="false" aria-label="Telefon" aria-live="polite">Pokaż telefon</span>
        </li>
      {% endif %}
    </ul>
  </div>
</header>
<main>
  <div class="container">
    {{ content | safe }}
    {% if testimonials.items and testimonials.items.length %}
    <h2>{{ testimonials.heading }}</h2>
    <div class="testimonials-grid">
      {% for item in testimonials.items %}
      <div class="testimonial card">
        <blockquote class="testimonial__quote">"{{ item.quote }}"</blockquote>
        <div class="testimonial__author">
          <strong class="testimonial__author-name">{{ item.author }}</strong>
          <em class="testimonial__author-info">{{ item.description }}</em>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if testimonials.cta and testimonials.cta.url %}
    <div class="testimonials-cta">
      <h3 class="testimonials-cta__title">{{ testimonials.cta.title }}</h3>
      <a href="{{ testimonials.cta.url }}" class="button">{{ testimonials.cta.link_text }}</a>
    </div>
    {% endif %}
  </div>
</main>
{% if footer %}<footer class="site-footer">{{ footer | withYear }}</footer>{% endif %}
<a href="#" class="back-to-top" aria-label="Przewiń do góry">↑</a>

<!-- Modal for image popup -->
<div class="modal" id="imageModal">
  <div class="modal__content">
    <div class="modal__close" aria-label="Zamknij">×</div>
    <img class="modal__image" src="" alt="" />
  </div>
</div>

<script>
  // Back to top button functionality
  document.addEventListener('DOMContentLoaded', function() {
    const backToTopButton = document.querySelector('.back-to-top');

    // Show/hide button based on scroll position
    window.addEventListener('scroll', function() {
      if (window.pageYOffset > 300) {
        backToTopButton.classList.add('back-to-top--visible');
      } else {
        backToTopButton.classList.remove('back-to-top--visible');
      }
    });

    // Smooth scroll to top when clicked
    backToTopButton.addEventListener('click', function(e) {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
    // Phone number: reveal on click (not on load)
    const phoneSpans = document.querySelectorAll('.phone-obf[data-enc]');
    phoneSpans.forEach(function(el){
      // Make it accessible as a button
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');

      const alphabet = 'qwertyuiop'; // allowed code letters only
      const codeDigits = '7145092863'; // mapping for q->7, w->1, ..., p->6
      const map = Object.fromEntries(alphabet.split('').map((ch, i) => [ch, codeDigits[i]]));

      function decodeDigits() {
        let enc = String(el.getAttribute('data-enc') || '');
        // keep only allowed letters; other chars are noise
        let filtered = enc.split('').filter(ch => alphabet.includes(ch)).join('');
        // optionally reverse (based on data attr)
        const rev = el.getAttribute('data-rev');
        if (rev === 'true' || rev === '1') {
          filtered = filtered.split('').reverse().join('');
        }
        // map letters -> digits
        const digits = filtered.split('').map(ch => map[ch]).join('');
        return digits;
      }

      function formatPretty(digits) {
        return digits.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3');
      }

      function revealPhone() {
        try {
          const raw = decodeDigits();
          if (!/^\d{9}$/.test(raw)) throw new Error('Decode failed');
          const pretty = formatPretty(raw);
          // Replace with a clickable tel link
          const a = document.createElement('a');
          a.className = 'contact-list__link';
          a.href = 'tel:' + raw;
          a.textContent = pretty;
          a.setAttribute('aria-label', 'Telefon: ' + pretty);
          el.replaceWith(a);
        } catch (e) {
          el.style.display = 'none';
        }
      }

      el.addEventListener('click', function onClick(){
        el.removeEventListener('click', onClick);
        revealPhone();
      });
      el.addEventListener('keydown', function onKey(e){
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          el.removeEventListener('keydown', onKey);
          revealPhone();
        }
      });
    });

    // Email: reveal on click (Base64 decode)
    const emailSpans = document.querySelectorAll('.email-obf[data-b64]');
    emailSpans.forEach(function(el){
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      function revealEmail(){
        try {
          const email = atob(el.getAttribute('data-b64') || '');
          if (!/.+@.+\..+/.test(email)) throw new Error('Bad email');
          const a = document.createElement('a');
          a.className = 'contact-list__link';
          a.href = 'mailto:' + email;
          a.textContent = email;
          a.setAttribute('aria-label', 'E-mail: ' + email);
          el.replaceWith(a);
        } catch (e) {
          el.style.display = 'none';
        }
      }
      el.addEventListener('click', function onClick(){
        el.removeEventListener('click', onClick);
        revealEmail();
      });
      el.addEventListener('keydown', function onKey(e){
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          el.removeEventListener('keydown', onKey);
          revealEmail();
        }
      });
    });
  });
</script>
<script src="{{ '/js/modal.js' | cacheBust }}"></script>
</body>
</html>

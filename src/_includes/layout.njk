<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Matematyka Się Liczy - Korepetycje z matematyki we Wrocławiu. Przygotowanie do egzaminów, nadrabianie zaległości, profesjonalne wsparcie.">
  <meta name="keywords" content="matematyka, korepetycje, Wrocław, matura, egzamin ósmoklasisty">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="Profesjonalne korepetycje z matematyki we Wrocławiu i online">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://matematykasieliczy.pl">
  <meta property="og:image" content="/images/logo.svg">
  <title>{{ title }}</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat:wght@500..700&family=Raleway:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<header class="site-header">
  <div class="hero-symbols" aria-hidden="true"><span>∑</span><span>π</span><span>√</span><span>∞</span><span>÷</span><span>x²</span><span>∫</span><span>=</span></div>
  <div class="site-header__container">
    <img alt="Matematyka Się Liczy - Logo" class="site-logo" src="/images/logo-candy.svg">
    {% set words = title.split(" ") %}
    <h1 class="site-title">{{ words.slice(0, -1).join(" ") }} <mark>{{ words | last }}</mark></h1>
    <h2 class="site-subtitle">{{ subtitle }}</h2>
    <ul class="contact-list" aria-label="Informacje kontaktowe">
      {# Contact details are base64-encoded against scrapers; js/main.js reveals them on click #}
      {% if contact.email %}
      <li class="contact-list__item"><span class="contact-list__link" data-contact="mailto" data-value="{{ contact.email | base64 }}">Pokaż e‑mail</span></li>
      {% endif %}
      {% if contact.phone %}
      <li class="contact-list__item"><span class="contact-list__link" data-contact="tel" data-value="{{ contact.phone | base64 }}">Pokaż telefon</span></li>
      {% endif %}
    </ul>
  </div>
</header>
<main>
  <div class="container">
    {% if intro %}<p class="lead">{{ intro }}</p>{% endif %}
    {{ content | safe }}
  </div>
</main>
{% if footer %}<footer class="site-footer">{{ footer | withYear }}</footer>{% endif %}
<a href="#" class="back-to-top" aria-label="Przewiń do góry">↑</a>
<script src="/js/main.js"></script>
</body>
</html>
